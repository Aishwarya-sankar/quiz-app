# .gitignore for Quiz Maker App

# Prevent sensitive or temporary files from being committed to Git

# Node.js and npm (if applicable, remove if not using Node.js)
node_modules/
package-lock.json
**/node_modules/**

# Temporary files created by some editors
*~
*.swp
*.swo
.DS_Store
.vscode/

# Log files
*.log
logs/
tmp/
temp/

# Dependency directories (if you use a bundler like webpack or parcel)
dist/
build/
out/
bundle/

# OS generated files
Thumbs.db

# If you are using a framework
# Example for React
#coverage/

# If you have any environment variables file
.env
.env.*
!/.env.example # unless you want to track the example file.

# Folders for uploaded files
uploads/
files/
data/

# Ignore the build folder if you are using a static site generator
# _site/ # For Jekyll
# public/ # For Hugo
# out/   # For Next.js
# build/  # For React
# dist/ # Vue

# Ignore the media folder
media/

# Ignore the downloaded packages
downloads/

# Ignore the compressed files
*.zip
*.rar
*.tar.gz
*.tar.bz2
*.7z

# Ignore the compiled files
*.class
*.pyc # Python
*.pyo

# Ignore the large data files
*.csv
*.dat
*.dump
*.sql

# Ignore the text files
*.txt

# Ignore the configuration files
config/
# but do not ignore the example
!config/config.example

# Ignore the secret key
secret_key.txt

# Ignore the image files
*.png
*.jpg
*.jpeg
*.gif
*.svg

# Ignore the video files
*.mp4
*.avi
*.mov

# Ignore the audio files
*.mp3
*.wav
*.ogg

# Ignore the font files
*.ttf
*.woff
*.woff2

# Ignore the backup files
*.bak
*.backup
*.orig

# Ignore the cache files
__pycache__/
*.pyc

# Ignore the auto generated files
*.min.js
*.min.css

# Ignore the documentation files
docs/
*.md

# Ignore the test files
tests/
test-results/

# Ignore the coverage files
coverage/

# Ignore the temporary files
temp/
tmp/

# Ignore the build artifacts
build/
dist/
out/

# Ignore the IDE specific files
.idea/ # IntelliJ
.project # Eclipse
*.iml

# Ignore the system files
.DS_Store # macOS
Thumbs.db # Windows
ehthumbs.db # Windows
Desktop.ini # Windows

# Ignore the files generated by the operating system
._*

# Ignore the files that are not needed in the repository
*.swp # Swap files
*.swo # Swap files
*.log # Log files
*.out # Output files
*.bak # Backup files
*.tmp # Temporary files
*.cache # Cache files
*.pyc # Compiled Python files
*.class # Compiled Java files
*.obj # Compiled object files
*.exe # Executable files
*.dll # Dynamic link library files
*.pdb # Program database files
*.idb # Incremental database files

# Ignore the files that are not needed in the production
dev/
# Ignore the files generated by the tools
.sass-cache/

# Ignore the files that are not needed in the deployment
deploy/

# Ignore the files that are not needed in the documentation
docs/

# Ignore the files that are not needed in the testing
test/

# Ignore the files that are not needed in the development
local/
